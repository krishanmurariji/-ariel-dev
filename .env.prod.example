# Reference only — these are set as Render environment variables (Dashboard
# or render.yaml with sync: false, filled in per-service), never committed.

DEBUG=False
SECRET_KEY=                      # Render can auto-generate this (see render.yaml)
ALLOWED_HOSTS=arielhr.onrender.com
CSRF_TRUSTED_ORIGINS=https://arielhr.onrender.com
TIME_ZONE=Asia/Kolkata

# Neon (free Postgres) — from the Neon dashboard, "Connection string"
DATABASE_URL=postgres://<user>:<password>@<project>.neon.tech/<db>?sslmode=require

# Backblaze B2 (free, S3-compatible, no card required) — for uploaded files
AWS_ACCESS_KEY_ID=            # B2 "keyID"
AWS_SECRET_ACCESS_KEY=        # B2 "applicationKey"
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com   # e.g. https://s3.us-west-004.backblazeb2.com
MEDIA_URL=/media
NAMESPACE=arielhr
