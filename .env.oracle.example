# Copy to .env.oracle (never commit it) and fill in.
# Free domain: create a subdomain at https://www.duckdns.org pointing at the VM's public IP.
DOMAIN=arielhr.duckdns.org
ALLOWED_HOSTS=arielhr.duckdns.org
CSRF_TRUSTED_ORIGINS=https://arielhr.duckdns.org

# Generate each with: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DB_INIT_PASSWORD=change-me

TIME_ZONE=Asia/Kolkata
GUNICORN_WORKERS=3
NAMESPACE=arielhr
